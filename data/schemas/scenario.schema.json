{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-petra.local/schema/scenario-v1.json",
  "title": "Petra scenario",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "version",
    "title",
    "warning",
    "seedPolicy",
    "organism",
    "environment",
    "citations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "status": {
      "enum": [
        "science",
        "research",
        "experimental",
        "sandbox"
      ]
    },
    "warning": {
      "type": "string",
      "minLength": 20
    },
    "seedPolicy": {
      "enum": [
        "user",
        "fixed-demo",
        "random-recorded"
      ]
    },
    "organism": {
      "type": "object"
    },
    "environment": {
      "type": "object",
      "properties": {
        "resourceContext": {
          "$ref": "#/$defs/resourceContext"
        },
        "engineeringDefaults": {
          "$ref": "#/$defs/engineeringDefaults"
        }
      },
      "additionalProperties": true
    },
    "drug": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "resourceDrugCompositionPolicy": {
          "type": "object",
          "properties": {
            "provenance": {
              "$ref": "#/$defs/provenance"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "genotypes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "provenance": {
            "$ref": "#/$defs/provenance"
          }
        },
        "additionalProperties": true
      }
    },
    "mutationTransitions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "provenance": {
            "$ref": "#/$defs/provenance"
          }
        },
        "additionalProperties": true
      }
    },
    "validationTargets": {
      "type": "object"
    },
    "citations": {
      "type": "object",
      "minProperties": 1
    },
    "transferAssumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "executionProfile": {
      "$ref": "#/$defs/ecologyExecutionProfile"
    },
    "composedParameterSet": {
      "$ref": "#/$defs/composedParameterSet"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "provenance": {
      "type": "object",
      "required": [
        "classification"
      ],
      "properties": {
        "classification": {
          "enum": [
            "measured",
            "derived",
            "transferred",
            "calibrated",
            "mechanistic_approximation",
            "engineering",
            "visual_only",
            "hypothesis_experimental",
            "transferred_mechanistic_approximation"
          ]
        },
        "citation": {
          "type": "string",
          "minLength": 1
        },
        "citations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "context": {
          "type": "string",
          "minLength": 1
        },
        "transformation": {
          "type": "string",
          "minLength": 1
        },
        "uncertainty": {
          "type": "string",
          "minLength": 1
        },
        "transferNote": {
          "type": "string",
          "minLength": 1
        },
        "calibrationNote": {
          "type": "string",
          "minLength": 1
        },
        "limitation": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "resourceContext": {
      "type": "object",
      "required": [
        "version",
        "bindingStatus",
        "representation",
        "concentrationUnit",
        "limitingSubstrate",
        "medium",
        "referenceTemperatureC",
        "boundary",
        "initialCondition",
        "biomassMapping",
        "provenance"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "bindingStatus": {
          "enum": [
            "unbound",
            "calibrated",
            "measured_or_transferred"
          ]
        },
        "representation": {
          "enum": [
            "dimensionless_model_resource",
            "physical_concentration"
          ]
        },
        "concentrationUnit": {
          "type": "string",
          "minLength": 1
        },
        "limitingSubstrate": {
          "type": [
            "string",
            "null"
          ]
        },
        "medium": {
          "type": [
            "string",
            "null"
          ]
        },
        "referenceTemperatureC": {
          "type": [
            "number",
            "null"
          ]
        },
        "boundary": {
          "enum": [
            "no_flux",
            "external_feed"
          ]
        },
        "initialCondition": {
          "type": "string",
          "minLength": 1
        },
        "biomassMapping": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "bindingStatus": {
                "const": "unbound"
              }
            },
            "required": [
              "bindingStatus"
            ]
          },
          "then": {
            "properties": {
              "representation": {
                "const": "dimensionless_model_resource"
              },
              "limitingSubstrate": {
                "type": "null"
              },
              "medium": {
                "type": "null"
              },
              "concentrationUnit": {
                "const": "model-resource"
              }
            }
          }
        }
      ]
    },
    "ecologyExecutionProfile": {
      "type": "object",
      "required": [
        "schemaVersion",
        "id",
        "version",
        "scenarioId",
        "scenarioVersion",
        "resourceContextVersion",
        "classification",
        "units",
        "hoursPerTick",
        "growth",
        "behaviorTargets",
        "provenance"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "scenarioId": {
          "type": "string",
          "minLength": 1
        },
        "scenarioVersion": {
          "type": "string",
          "minLength": 1
        },
        "resourceContextVersion": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "const": "engineering"
        },
        "units": {
          "type": "object",
          "required": [
            "time",
            "resource",
            "biomass"
          ],
          "properties": {
            "time": {
              "const": "hour"
            },
            "resource": {
              "const": "model-resource"
            },
            "biomass": {
              "const": "model-biomass"
            }
          },
          "additionalProperties": false
        },
        "hoursPerTick": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "growth": {
          "type": "object",
          "required": [
            "maxDivisionRate",
            "halfSaturation",
            "biomassYield",
            "localCapacity",
            "spreadRate"
          ],
          "properties": {
            "maxDivisionRate": {
              "type": "number",
              "minimum": 0
            },
            "halfSaturation": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "biomassYield": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "localCapacity": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "spreadRate": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "behaviorTargets": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "positive-early-growth",
              "resource-depletion",
              "zero-resource-no-growth",
              "capacity-bound",
              "conservative-neighbour-spread"
            ]
          }
        },
        "provenance": {
          "type": "object",
          "required": [
            "classification",
            "context",
            "calibrationNote",
            "limitation"
          ],
          "properties": {
            "classification": {
              "const": "engineering"
            },
            "context": {
              "type": "string",
              "minLength": 1
            },
            "calibrationNote": {
              "type": "string",
              "minLength": 1
            },
            "limitation": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "engineeringDefaults": {
      "type": "object",
      "required": [
        "gridSize",
        "dishRadiusCells",
        "cellSize",
        "cellSizeUnit",
        "note"
      ],
      "properties": {
        "gridSize": {
          "type": "integer",
          "minimum": 3
        },
        "dishRadiusCells": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cellSize": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cellSizeUnit": {
          "const": "model-grid-cell"
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "composedParameterSet": {
      "type": "object",
      "required": [
        "schemaVersion",
        "id",
        "version",
        "scenarioId",
        "scenarioVersion",
        "executionProfileId",
        "executionProfileVersion",
        "resourceContextVersion",
        "geometrySource",
        "lossPolicyId",
        "lineages",
        "provenance"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "scenarioId": {
          "type": "string",
          "minLength": 1
        },
        "scenarioVersion": {
          "type": "string",
          "minLength": 1
        },
        "executionProfileId": {
          "type": "string",
          "minLength": 1
        },
        "executionProfileVersion": {
          "type": "string",
          "minLength": 1
        },
        "resourceContextVersion": {
          "type": "string",
          "minLength": 1
        },
        "geometrySource": {
          "const": "environment.engineeringDefaults"
        },
        "lossPolicyId": {
          "type": "string",
          "minLength": 1
        },
        "lineages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "genotypeId",
              "deathHazardPerHour",
              "provenance"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "genotypeId": {
                "type": "string",
                "minLength": 1
              },
              "deathHazardPerHour": {
                "type": "number",
                "minimum": 0
              },
              "provenance": {
                "$ref": "#/$defs/provenance"
              }
            },
            "additionalProperties": false
          }
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "additionalProperties": false
    }
  }
}
