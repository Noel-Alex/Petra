{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-petra.local/schema/scenario-v1.json",
  "title": "Petra scenario",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "version",
    "title",
    "warning",
    "seedPolicy",
    "organism",
    "environment",
    "citations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "status": {
      "enum": [
        "science",
        "research",
        "experimental",
        "sandbox"
      ]
    },
    "warning": {
      "type": "string",
      "minLength": 20
    },
    "seedPolicy": {
      "enum": [
        "user",
        "fixed-demo",
        "random-recorded"
      ]
    },
    "organism": {
      "type": "object"
    },
    "environment": {
      "type": "object"
    },
    "drug": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "resourceDrugCompositionPolicy": {
          "type": "object",
          "properties": {
            "provenance": {
              "$ref": "#/$defs/provenance"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "genotypes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "provenance": {
            "$ref": "#/$defs/provenance"
          }
        },
        "additionalProperties": true
      }
    },
    "mutationTransitions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "provenance": {
            "$ref": "#/$defs/provenance"
          }
        },
        "additionalProperties": true
      }
    },
    "validationTargets": {
      "type": "object"
    },
    "citations": {
      "type": "object",
      "minProperties": 1
    },
    "transferAssumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "provenance": {
      "type": "object",
      "required": [
        "classification"
      ],
      "properties": {
        "classification": {
          "enum": [
            "measured",
            "derived",
            "transferred",
            "calibrated",
            "mechanistic_approximation",
            "engineering",
            "visual_only",
            "hypothesis_experimental",
            "transferred_mechanistic_approximation"
          ]
        },
        "citation": {
          "type": "string",
          "minLength": 1
        },
        "citations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "context": {
          "type": "string",
          "minLength": 1
        },
        "transformation": {
          "type": "string",
          "minLength": 1
        },
        "uncertainty": {
          "type": "string",
          "minLength": 1
        },
        "transferNote": {
          "type": "string",
          "minLength": 1
        },
        "calibrationNote": {
          "type": "string",
          "minLength": 1
        },
        "limitation": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
